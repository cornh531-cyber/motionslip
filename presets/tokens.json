{
  "description": "design token global — warna, tipografi, spacing, radius",
  "credit": "rajxzdev",
  "license": "Apache-2.0",
  "version": "1.0.0",
  "color": {
    "bg": { "dark": "#0B0B10", "deep": "#080A12", "obsidian": "#05060B", "light": "#F7F7FA" },
    "accent": {
      "violet": "#7C5CFF",
      "rose": "#FF5C7A",
      "mint": "#2EE6A8",
      "sky": "#4C8DFF",
      "cyan": "#00D8FF",
      "amber": "#FFB43A"
    },
    "text": { "primary": "#FFFFFF", "secondary": "#9A9AAC", "muted": "#8892A6", "onAccent": "#0B0714" },
    "surface": { "card": "#121624", "line": "#1E1E2A" }
  },
  "type": {
    "family": "Inter, system-ui, -apple-system, sans-serif",
    "display": { "size": 150, "weight": 900, "lineHeight": 0.95, "letterSpacing": -4 },
    "headline": { "size": 118, "weight": 900, "lineHeight": 1.0, "letterSpacing": -2 },
    "subline": { "size": 44, "weight": 500, "lineHeight": 1.3, "letterSpacing": 0 },
    "body": { "size": 38, "weight": 500, "lineHeight": 1.35, "letterSpacing": 0 },
    "label": { "size": 30, "weight": 700, "lineHeight": 1.2, "letterSpacing": 6 },
    "kicker": { "size": 32, "weight": 600, "lineHeight": 1.2, "letterSpacing": 8 },
    "stat": { "size": 240, "weight": 900, "lineHeight": 1.0, "letterSpacing": -6 }
  },
  "space": { "xs": 8, "sm": 16, "md": 32, "lg": 56, "xl": 96 },
  "radius": { "sm": 8, "md": 24, "pill": 999 },
  "safeArea": {
    "vertical1080x1920": { "top": 120, "bottom": 250, "side": 72 },
    "square1080": { "top": 90, "bottom": 90, "side": 90 }
  }
}
